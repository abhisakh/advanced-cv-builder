# ======================================================================
# Advanced CV Builder - Environment Configuration
# ======================================================================
# Copy this file to `.env` and fill in your settings
# Example: cp env.example .env

# ======================================================================
# Google Gemini API Configuration (Optional - for AI Suggestions)
# ======================================================================
# Get your API key from: https://console.cloud.google.com
# The app works without this, but AI features will be disabled
# Gemini API is faster and more affordable than alternatives!

GEMINI_API_KEY=your-gemini-api-key-here

# ======================================================================
# Streamlit Configuration (Optional)
# ======================================================================
# Theme settings
STREAMLIT_THEME_PRIMARY_COLOR=#2b3a4a
STREAMLIT_THEME_BACKGROUND_COLOR=#ffffff
STREAMLIT_THEME_SECONDARY_COLOR=#f0f4f8
STREAMLIT_THEME_TEXT_COLOR=#2d3748

# Server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HOST=localhost
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=50

# ======================================================================
# Application Settings
# ======================================================================
# Profiles storage directory
SAVED_PROFILES_DIR=saved_cvs
VERSION_HISTORY_DIR=cv_versions

# Default values
DEFAULT_FULL_NAME=Your Name
DEFAULT_TITLE=Professional Title
DEFAULT_LOCATION=City, Country
DEFAULT_EMAIL=your@email.com
DEFAULT_PHONE=+1 234 567 8900

# ======================================================================
# Feature Flags
# ======================================================================
ENABLE_AI_SUGGESTIONS=true
ENABLE_PDF_EXPORT=true
ENABLE_JSON_EXPORT=true
ENABLE_VERSION_HISTORY=true
ENABLE_PROFILE_PHOTO=true
ENABLE_TEXT_FORMATTING=true
ENABLE_SECTION_MANAGEMENT=true

# ======================================================================
# Template Settings
# ======================================================================
# Default template on app load
DEFAULT_TEMPLATE=Modern

# Available templates (don't change unless customizing)
AVAILABLE_TEMPLATES=Modern,Classic,Minimal,Creative

# ======================================================================
# Font Settings
# ======================================================================
AVAILABLE_FONTS=Helvetica,Arial,Georgia,Times New Roman
DEFAULT_FONT=Helvetica
DEFAULT_HEADING_SIZE=13
DEFAULT_BODY_SIZE=10
DEFAULT_LINE_HEIGHT=1.4

# ======================================================================
# Color Presets
# ======================================================================
# Modern template colors
MODERN_PRIMARY=#2b3a4a
MODERN_ACCENT=#0066cc
MODERN_SIDEBAR_BG=#f0f4f8

# Classic template colors
CLASSIC_PRIMARY=#1a1a1a
CLASSIC_ACCENT=#333333
CLASSIC_SIDEBAR_BG=#ffffff

# Minimal template colors
MINIMAL_PRIMARY=#000000
MINIMAL_ACCENT=#666666
MINIMAL_SIDEBAR_BG=#ffffff

# Creative template colors
CREATIVE_PRIMARY=#E63946
CREATIVE_ACCENT=#A23B72
CREATIVE_SIDEBAR_BG=#F7F7F7

# ======================================================================
# Validation Settings
# ======================================================================
# Email validation enabled
VALIDATE_EMAIL=true

# Phone validation enabled
VALIDATE_PHONE=true

# URL validation enabled
VALIDATE_URL=true

# Minimum summary length (characters)
MIN_SUMMARY_LENGTH=50

# Recommended summary length (characters)
RECOMMENDED_SUMMARY_LENGTH=150

# ======================================================================
# Text Formatting Settings
# ======================================================================
# Built-in text formatter - supports markdown-like syntax
ENABLE_FORMATTING=true
FORMATTING_HELP_TEXT=Use **bold**, *italic*, `code`, ^super^, ~sub~, etc.

# ======================================================================
# Section Management Settings
# ======================================================================
# Allow users to control section visibility
ENABLE_SECTION_VISIBILITY=true

# Allow users to reorder sections
ENABLE_SECTION_ORDERING=true

# Allow users to place sections in different columns
ENABLE_SECTION_PLACEMENT=true

# Available section types
SECTION_TYPES=Experience Layout,Certification Layout,Summary Layout,Projects,Technical Skills,Soft Skills,Generic Text

# ======================================================================
# PDF Settings
# ======================================================================
# Page format
PDF_PAGE_SIZE=A4
PDF_ORIENTATION=portrait

# Margin settings (mm)
PDF_MIN_MARGIN=8
PDF_MAX_MARGIN=25
PDF_DEFAULT_MARGIN=12

# ======================================================================
# File Upload Settings
# ======================================================================
# Max file size for profile photo (MB)
MAX_PHOTO_SIZE=5

# Allowed image formats
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png

# ======================================================================
# Performance Settings
# ======================================================================
# Enable caching
ENABLE_CACHE=true

# Cache timeout (seconds)
CACHE_TIMEOUT=3600

# ======================================================================
# API Settings
# ======================================================================
# Gemini API Model (gemini-2.5-flash recommended for speed)
GEMINI_MODEL=gemini-2.5-flash

# Max tokens for AI responses
AI_MAX_TOKENS=1000

# Temperature for AI creativity (0-1, higher = more creative)
AI_TEMPERATURE=0.7

# ======================================================================
# Notes
# ======================================================================
# 1. Only GEMINI_API_KEY is required for AI features (optional)
# 2. All other settings are optional with sensible defaults
# 3. Do NOT commit this file to git (add to .gitignore)
# 4. Keep API keys private and secure
# 5. Use environment variables in production
# 6. Text formatting is BUILT-IN - no external dependencies!
# 7. Section management allows full user control over CV layout
# 8. Gemini API is faster and more affordable than alternatives
